{
  "version": 2,
  "builds": [
    {
      "src": "dist/rana-al-cabin/server/server.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "dist/rana-al-cabin/browser/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/media/(.*)",
      "dest": "/media/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/favicon.ico"
    },
    {
      "src": "/(.*\\.(js|css|png|jpg|jpeg|gif|svg|webm|woff|woff2|ttf|eot|ico|json))$",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "dist/rana-al-cabin/server/server.mjs"
    }
  ]
}
